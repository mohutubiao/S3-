CONFIG_BOARD_TYPE_ZHENGCHEN_CAM=y

# 以下按 main/boards/zhengchen/cam/config.json 的官方推荐值
CONFIG_USE_DEVICE_AEC=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=48
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=n
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_USE_FONT_PLACEHOLDER=y

# 2026-11-15 socket 表上限 10 → 16。
# 原值 10 时：主控制页 httpd(4) + 图传 httpd(3) + WebSocket(1) + 监听/DNS/SNTP(2~3)
# 直接把表占满，新连接 accept 直接返回 errno 23 (ENFILE)：
#   E httpd: httpd_accept_conn: error in accept (23)
# 表现为「手机打开控制页费劲」「图传点了没画面」（81 口服务器起来了但 /stream 进不来）。
# 每个 socket 约 100~200 字节，内部 SRAM 现在空闲 67KB，代价 1~2KB，可接受。
CONFIG_LWIP_MAX_SOCKETS=16
